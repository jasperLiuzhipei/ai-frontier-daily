# ==========================================
# LLM API 配置（标准 OpenAI 兼容协议）
# ==========================================
# DeepSeek 官方地址为 https://api.deepseek.com/v1
# 如果你的接口来自中转/聚合平台，把这里改成对应平台的 Base URL 即可
LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 也可使用通用变量 LLM_API_KEY（优先级高于 DEEPSEEK_API_KEY）
# LLM_API_KEY=

# 模型名称默认由 config/llm.json 管理（主模型 deepseek-flash，备用 deepseek-v4-pro）
# 若你的中转平台使用自定义模型名，可直接修改 config/llm.json 或取消下面注释：
# LLM_MODEL=deepseek-flash

# ==========================================
# 飞书推送配置（推荐自建应用消息 API：支持 1 小时 uuid 幂等防重，0 漏发 + 0 重发）
# 可选值：auto（优先飞书应用 API > Webhook）| feishu | feishu-app | feishu-webhook
# ==========================================
NOTIFY_CHANNEL=feishu

# 方式一（推荐）：飞书企业自建应用消息 API（im/v1/messages）
# 在 https://open.feishu.cn/app「凭证与基础信息」获取 App ID 与 App Secret，
# 把应用机器人拉进目标群后运行 `python3 run.py feishu-chats` 即可自动获取 FEISHU_CHAT_ID
FEISHU_APP_ID=cli_your-app-id
FEISHU_APP_SECRET=your-app-secret
FEISHU_CHAT_ID=oc_your-group-chat-id
# 可选：默认 chat_id（发群聊），也可改为 open_id 发私聊
# FEISHU_RECEIVE_ID_TYPE=chat_id

# 方式二（可选兼容）：旧版自定义群机器人 Webhook
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
# FEISHU_WEBHOOK_SECRET=

# ==========================================
# 无人值守外部死信监控（强烈推荐：Healthchecks.io 免费版）
# 仅在飞书确认送达且 delivery-state 回执保存成功后上报；若 11:15 前未收到成功心跳自动发邮件告警
# ==========================================
# HEALTHCHECK_PING_URL=https://hc-ping.com/your-check-uuid

# ==========================================
# 可选配置
# ==========================================
# 时区（默认跟随系统；GitHub Actions 中固定为 Asia/Shanghai）
# AI_DAILY_TZ=Asia/Shanghai
# GitHub Token（可选，提高 GitHub API 限额）
# GITHUB_TOKEN=
# HTTP 代理（本地访问海外 RSS 受限时可配置，如 http://127.0.0.1:7890）
# HTTPS_PROXY=
